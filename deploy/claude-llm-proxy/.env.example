# claude-llm-proxy — 用 Claude Pro/Max 訂閱身分（而不是 API key）當 MemoryCore
# 的抽取 LLM。proxy 對 MemoryCore 假裝自己是 OpenAI-compatible 端點，實際收到
# 請求後在背後呼叫 `claude -p`，用這個 token 認證。
#
# 取得方式：在你自己開的終端機（不是透過 Claude Code 對話框的 `!`，那個環境
# 沒有真正的 tty，跑不動互動式登入）執行：
#   claude setup-token
# 完成瀏覽器授權後會印出一串 sk-ant-oat01-... 開頭的文字，複製貼到下面。
#
# 用途：只給這個 proxy 內部呼叫 claude -p 用，跟你平常互動用 Claude Code 是
# 同一份訂閱額度（5 小時滾動窗口），會互相排擠 —— 不是另外收費。
CLAUDE_CODE_OAUTH_TOKEN=

# 抽取用的模型別名（sonnet 比預設的 opus 省額度很多，L1 抽取這種純文字任務
# 用 sonnet 就夠；可選 sonnet / opus / haiku，或完整 model 名稱）
CLAUDE_LLM_PROXY_MODEL=sonnet

# proxy 監聽的 port —— MemoryCore 的 MEMORY_LLM_BASE_URL 要指到這裡
CLAUDE_LLM_PROXY_PORT=8622
